APP_NAME=AAF-AIOS
ENVIRONMENT=dev
DEBUG=false
API_PREFIX=/api/v1
DEMO_MODE=false
DATABASE_URL=sqlite:///./agentic.db
MONGODB_URI=
MONGODB_DB=agentic
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
KEYCLOAK_URL=http://localhost:8080
OPA_URL=http://localhost:8181
VAULT_URL=http://localhost:8200

# Providers
VECTOR_PROVIDER=chroma
QUEUE_PROVIDER=redis_rq
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Calendar integration
CALENDAR_PROVIDER=local
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
MICROSOFT_GRAPH_ACCESS_TOKEN=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALENDAR_USER_ID=
MICROSOFT_CALENDAR_ID=primary

# Celery
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_BACKEND_URL=rpc://

# Observability and gateways
OPENAI_MODEL=qwen3:8b
OPENAI_BASE_URL=http://192.168.0.118:11434/v1
OPENAI_API_KEY=ollama
LANGSMITH_PROJECT=agentic-system
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
HELICONE_API_KEY=
HELICONE_BASE_URL=https://oai.helicone.ai/v1
HELICONE_ENABLED=false

# Ollama runtime
OLLAMA_BASE_URL=http://192.168.0.118:11434
OLLAMA_CHAT_MODEL=qwen3:8b
# Put your other local models here as comma-separated fallback list.
# Example with 4 local models total: 1 primary + 3 fallback.
OLLAMA_FALLBACK_MODELS=llama3.1:8b,qwen3:0.5b,phi3:mini
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# Budget controls
BUDGET_TASK_LIMIT=100000
BUDGET_USER_LIMIT=1000000
BUDGET_ORG_LIMIT=10000000

# Sandbox
SANDBOX_OFFLINE_MODE=true
INTERACTIVE_QUEUE_P95_MS_TARGET=500
SHORT_MEMORY_TTL_SECONDS=3600
